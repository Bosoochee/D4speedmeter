#:kivy 2.3
#:import Factory kivy.factory.Factory

#:set C_BG (0.07, 0.07, 0.09, 1)
#:set C_TILE (0.13, 0.13, 0.17, 1)
#:set C_MUTED (0.6, 0.6, 0.66, 1)
#:set C_ACCENT (1, 0.75, 0.3, 1)

<FlatButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0.25, 0.25, 0.32, 1
    font_size: sp(15)

<BluetoothButton@FlatButton>:
    # Bouton rond avec icône Bluetooth dessinée (la police par défaut n'a pas ce symbole).
    # Orange : vélo non connecté (appuyer pour chercher) ; bleu : connecté (appuyer pour déconnecter).
    connected: False
    text: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: ((0.15, 0.45, 0.85, 1) if self.connected else (0.92, 0.5, 0.1, 1)) if self.state == "normal" else ((0.1, 0.32, 0.62, 1) if self.connected else (0.7, 0.38, 0.08, 1))
        Ellipse:
            pos: self.center_x - min(self.size) / 2, self.center_y - min(self.size) / 2
            size: min(self.size), min(self.size)
    canvas.after:
        Color:
            rgba: 1, 1, 1, 1
        Line:
            width: max(dp(1.6), self.height * 0.035)
            joint: "miter"
            cap: "square"
            points:
                (self.center_x - self.height * 0.14, self.center_y + self.height * 0.14,
                self.center_x + self.height * 0.14, self.center_y - self.height * 0.14,
                self.center_x, self.center_y - self.height * 0.28,
                self.center_x, self.center_y + self.height * 0.28,
                self.center_x + self.height * 0.14, self.center_y + self.height * 0.14,
                self.center_x - self.height * 0.14, self.center_y - self.height * 0.14)

<GearButton>:
    # Roue dentée dessinée dans icons.py
    background_normal: ""
    background_down: ""
    background_color: 0.25, 0.25, 0.32, 1

<Tile@ButtonBehavior+BoxLayout>:
    # Touchable : `on_release` ouvre la courbe correspondante (puissance, cadence)
    title: ""
    value: ""
    value_color: 1, 1, 1, 1
    value_size: sp(30)
    value_fill: 0.85    # part de la hauteur de la valeur occupée par le texte
    title_ratio: 1      # hauteur du titre relative à la valeur (plus petit = valeur plus grande)
    orientation: "vertical"
    padding: dp(8), dp(4)
    canvas.before:
        Color:
            rgba: (0.2, 0.2, 0.26, 1) if self.state == "down" else C_TILE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
    Label:
        text: root.title
        # Réduit si le titre est trop long pour la largeur (grandes polices système)
        font_size: min(sp(13), self.height * 0.6, self.width / (0.65 * max(len(self.text), 1)))
        color: C_MUTED
        text_size: self.width, None
        halign: "center"
        shorten: True
        size_hint_y: root.title_ratio
    Label:
        text: root.value
        font_size: min(root.value_size, self.height * root.value_fill)
        bold: True
        color: root.value_color

<SpeedScreen>:
    orientation: "vertical"
    padding: dp(12), dp(8) + root.inset_top, dp(12), dp(10) + root.inset_bottom
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: C_BG
        Rectangle:
            pos: self.pos
            size: self.size

    # --- Barre du haut ---
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(8)
        Label:
            text: "D4speedmeter"
            font_size: min(sp(20), self.height * 0.6)
            bold: True
            halign: "left"
            text_size: self.size
            valign: "middle"
        GearButton:
            size_hint_x: None
            width: self.height * 1.3
            on_release: app.open_settings_popup()

    # --- Compteur : hauteur utile du cadran (ouvert en bas), sans dépasser 55 % de l'écran ---
    # Toucher le cadran affiche la courbe de vitesse
    TapArea:
        size_hint_y: None
        height: min(self.width * 0.86, root.height * 0.55)
        on_release: app.open_chart("speed")
        Gauge:
            id: gauge
            value: root.speed
            max_value: 50
            pos_hint: {"x": 0, "y": 0}
        Label:
            text: "{:.1f}".format(root.speed)
            bold: True
            font_size: gauge.radius * 0.34
            size_hint: None, None
            size: gauge.radius * 0.9, gauge.radius * 0.36
            center: gauge.dial_cx, gauge.dial_cy - gauge.radius * 0.30
        Label:
            text: "km/h"
            color: C_MUTED
            font_size: gauge.radius * 0.11
            size_hint: None, None
            size: gauge.radius * 0.5, gauge.radius * 0.14
            center: gauge.dial_cx, gauge.dial_cy - gauge.radius * 0.58
        # Voyant GPS : toucher pour afficher le tracé sur la carte
        GpsBadge:
            satellites: root.gps_sats
            size_hint: None, None
            size: [max(dp(40), gauge.radius * 0.24)] * 2
            center: gauge.dial_cx, gauge.dial_cy + gauge.radius * 0.36
            on_release: app.open_map()

    # --- Connexion vélo ---
    BoxLayout:
        size_hint_y: None
        height: dp(48)
        spacing: dp(8)
        Label:
            text: root.status + "  ·  " + root.speed_source
            shorten_from: "right"
            font_size: min(sp(12), self.height * 0.34)
            color: C_MUTED
            text_size: self.size
            halign: "left"
            valign: "middle"
            shorten: True
        BluetoothButton:
            connected: root.bike_connected
            size_hint_x: None
            width: self.height
            on_release: app.bike_button()

    # --- Statistiques ---
    GridLayout:
        cols: 2
        spacing: dp(8)
        Tile:
            title: "Batterie vélo"
            value: "--" if root.battery < 0 else "{:.0f} %".format(root.battery)
            value_color: (1, 1, 1, 1) if root.battery < 0 or root.battery > 20 else (1, 0.35, 0.3, 1)
        Tile:
            title: "Vitesse moyenne"
            value: "{:.1f} km/h".format(root.avg_speed)
        Tile:
            title: "Puissance  ›"
            value: "--" if root.power < 0 else "{:.0f} W".format(root.power)
            on_release: app.open_chart("power")
        Tile:
            title: "Cadence  ›"
            value: "--" if root.cadence < 0 else "{:.0f} tr/min".format(root.cadence)
            on_release: app.open_chart("cadence")
        Tile:
            title: "Heure"
            value: root.clock
            value_color: C_ACCENT
            value_size: sp(52)
            value_fill: 1
            title_ratio: 0.3
        Tile:
            title: "Temps de déplacement"
            value: root.moving_time

    # --- Distance + reset ---
    BoxLayout:
        size_hint_y: None
        height: dp(60)
        spacing: dp(8)
        Tile:
            title: "Trip km"
            value: "{:.2f} km".format(root.distance)
        ResetButton:
            size_hint: None, None
            size: dp(44), dp(44)
            pos_hint: {"center_y": 0.5}
            on_release: app.reset_trip()
        PowerButton:
            size_hint: None, None
            size: dp(44), dp(44)
            pos_hint: {"center_y": 0.5}
            on_release: Factory.QuitPopup().open()


<TapArea@ButtonBehavior+FloatLayout>:

<ResetButton@ButtonBehavior+Widget>:
    # Bouton rond « Trip reset » : flèche circulaire (cercle ouvert + pointe en haut)
    canvas:
        Color:
            rgba: (0.6, 0.4, 0.15, 1) if self.state == "normal" else (0.42, 0.28, 0.1, 1)
        Ellipse:
            pos: self.center_x - min(self.size) / 2, self.center_y - min(self.size) / 2
            size: min(self.size), min(self.size)
        Color:
            rgba: 1, 1, 1, 1
        Line:
            circle: self.center_x, self.center_y, min(self.size) * 0.24, 90, 345
            width: max(dp(1.5), min(self.size) * 0.05)
            cap: "round"
        Triangle:
            points: self.center_x + min(self.size) * 0.10, self.center_y + min(self.size) * 0.24, self.center_x - min(self.size) * 0.05, self.center_y + min(self.size) * 0.37, self.center_x - min(self.size) * 0.05, self.center_y + min(self.size) * 0.11

<PowerButton@ButtonBehavior+Widget>:
    # Bouton rond « Quitter » : symbole marche/arrêt (cercle ouvert + trait vertical)
    canvas:
        Color:
            rgba: (0.62, 0.18, 0.18, 1) if self.state == "normal" else (0.45, 0.12, 0.12, 1)
        Ellipse:
            pos: self.center_x - min(self.size) / 2, self.center_y - min(self.size) / 2
            size: min(self.size), min(self.size)
        Color:
            rgba: 1, 1, 1, 1
        Line:
            circle: self.center_x, self.center_y - min(self.size) * 0.02, min(self.size) * 0.24, 35, 325
            width: max(dp(1.5), min(self.size) * 0.05)
            cap: "round"
        Line:
            points: self.center_x, self.center_y + min(self.size) * 0.04, self.center_x, self.center_y + min(self.size) * 0.3
            width: max(dp(1.5), min(self.size) * 0.05)
            cap: "round"

<GpsBadge@ButtonBehavior+Widget>:
    # Voyant GPS en forme de carte pliée (toucher : tracé sur la carte).
    # Couleur : gris = inconnu, rouge = aucun satellite, orange < 5, vert >= 5
    satellites: -1
    canvas:
        Color:
            rgba: (0.2, 0.2, 0.25, 1) if self.state == "down" else (0.12, 0.12, 0.15, 0.85)
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: (0.55, 0.55, 0.6, 1) if self.satellites < 0 else ((0.95, 0.25, 0.2, 1) if self.satellites == 0 else ((1, 0.6, 0.1, 1) if self.satellites < 5 else (0.25, 0.8, 0.3, 1)))
        # Contour : trois volets en accordéon
        Line:
            points: self.center_x - self.width * 0.30, self.center_y + self.width * 0.18, self.center_x - self.width * 0.10, self.center_y + self.width * 0.25, self.center_x + self.width * 0.10, self.center_y + self.width * 0.18, self.center_x + self.width * 0.30, self.center_y + self.width * 0.25, self.center_x + self.width * 0.30, self.center_y - self.width * 0.18, self.center_x + self.width * 0.10, self.center_y - self.width * 0.25, self.center_x - self.width * 0.10, self.center_y - self.width * 0.18, self.center_x - self.width * 0.30, self.center_y - self.width * 0.25
            close: True
            joint: "round"
            width: max(dp(1.4), self.width * 0.04)
        # Plis
        Line:
            points: self.center_x - self.width * 0.10, self.center_y + self.width * 0.25, self.center_x - self.width * 0.10, self.center_y - self.width * 0.18
            width: max(dp(1.2), self.width * 0.03)
        Line:
            points: self.center_x + self.width * 0.10, self.center_y + self.width * 0.18, self.center_x + self.width * 0.10, self.center_y - self.width * 0.25
            width: max(dp(1.2), self.width * 0.03)

<MapPopup@Popup>:
    title: "Tracé GPS depuis le dernier reset"
    size_hint: 0.98, 0.92
    BoxLayout:
        orientation: "vertical"
        spacing: dp(6)
        BoxLayout:
            id: map_holder
        Label:
            text: "© OpenStreetMap, SRTM | © OpenTopoMap (CC-BY-SA)"
            font_size: sp(10)
            color: C_MUTED
            size_hint_y: None
            height: dp(16)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            FlatButton:
                text: "Recentrer"
                on_release: app.recenter_map()
            FlatButton:
                text: "Fermer"
                on_release: root.dismiss()

<GpsOffPopup@Popup>:
    title: "GPS désactivé"
    size_hint: 0.85, None
    height: dp(210)
    BoxLayout:
        orientation: "vertical"
        spacing: dp(10)
        Label:
            text: "La localisation du téléphone est coupée : pas de vitesse GPS ni de tracé.\nL'activer maintenant ?"
            font_size: sp(14)
            halign: "center"
            text_size: self.width, None
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            FlatButton:
                text: "Plus tard"
                on_release: root.dismiss()
            FlatButton:
                text: "Activer le GPS"
                background_color: 0.15, 0.45, 0.85, 1
                on_release: root.dismiss(); app.open_location_settings()

<SplashScreen>:
    canvas.before:
        Color:
            rgba: C_BG
        Rectangle:
            pos: self.pos
            size: self.size
    Image:
        source: "assets/icon.png"
        size_hint: None, None
        size: [min(root.width, root.height) * 0.45] * 2
        center: root.center_x, root.center_y + self.height * 0.15
    Label:
        # Largeur fixe calée à gauche : le texte ne bouge pas quand les points s'ajoutent
        text: "By Bosoochee" + "." * root.dots
        font_size: sp(22)
        color: C_MUTED
        size_hint: None, None
        size: dp(220), dp(40)
        text_size: self.size
        halign: "left"
        valign: "middle"
        padding: dp(30), 0
        center_x: root.center_x
        top: root.center_y - min(root.width, root.height) * 0.45 * 0.38

<ChartPopup@Popup>:
    key: "speed"
    summary: ""
    size_hint: 0.95, 0.6
    BoxLayout:
        orientation: "vertical"
        spacing: dp(8)
        HistoryChart:
            id: chart
            color: C_ACCENT
        Label:
            text: root.summary
            font_size: sp(15)
            bold: True
            size_hint_y: None
            height: dp(30)
        FlatButton:
            text: "Fermer"
            size_hint_y: None
            height: dp(48)
            on_release: root.dismiss()

<QuitPopup@Popup>:
    title: "Quitter D4speedmeter ?"
    size_hint: 0.85, None
    height: dp(200)
    BoxLayout:
        orientation: "vertical"
        spacing: dp(10)
        Label:
            text: "Les données du trajet sont sauvegardées.\nLe suivi en tâche de fond s'arrête."
            font_size: sp(14)
            halign: "center"
            text_size: self.width, None
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            FlatButton:
                text: "Annuler"
                on_release: root.dismiss()
            FlatButton:
                text: "Quitter"
                background_color: 0.5, 0.15, 0.15, 1
                on_release: root.dismiss(); app.quit_app()

<DeviceButton@FlatButton>:
    markup: True
    halign: "center"
    size_hint_y: None
    height: dp(56)

<DevicesPopup@Popup>:
    title: "Choisir le vélo"
    size_hint: 0.9, 0.7
    BoxLayout:
        orientation: "vertical"
        spacing: dp(8)
        Label:
            text: "Recherche des appareils Bluetooth à proximité...\nAllumez l'écran du vélo."
            font_size: sp(13)
            color: C_MUTED
            size_hint_y: None
            height: dp(40)
            halign: "center"
        ScrollView:
            BoxLayout:
                id: device_list
                orientation: "vertical"
                spacing: dp(6)
                size_hint_y: None
                height: self.minimum_height
        FlatButton:
            text: "Annuler"
            size_hint_y: None
            height: dp(48)
            on_release: root.dismiss()

<SettingsPopup@Popup>:
    title: "Paramètres"
    size_hint: 0.9, 0.68
    BoxLayout:
        orientation: "vertical"
        spacing: dp(10)
        padding: dp(4)
        Label:
            text: "D4speedmeter"
            font_size: sp(22)
            bold: True
            size_hint_y: None
            height: dp(36)
        Label:
            text: "Version " + app.version
            size_hint_y: None
            height: dp(24)
        Label:
            text: "Auteur : " + app.author
            size_hint_y: None
            height: dp(24)
        Label:
            text: "Km total du vélo : " + ("--" if app.screen.odometer_km < 0 else "{:.1f} km".format(app.screen.odometer_km))
            color: C_ACCENT
            size_hint_y: None
            height: dp(24)
        ScrollView:
            Label:
                text: app.summary
                font_size: sp(14)
                color: 0.85, 0.85, 0.88, 1
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
        Label:
            text: "Journal Bluetooth :\n" + app.log_path
            font_size: sp(11)
            color: C_MUTED
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1] + dp(4)
        FlatButton:
            text: "Fermer"
            size_hint_y: None
            height: dp(48)
            on_release: root.dismiss()
